{
  "name": "siteshift-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "siteshift-monorepo",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/cli": {
      "name": "siteshift",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@siteshift/core": "0.1.0"
      },
      "bin": {
        "siteshift": "bin/siteshift.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@siteshift/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/playwright": {
      "version": "1.65.0",
      "resolved": "https://registry.npmjs.org/playwright/-/playwright-1.65.0.tgz",
      "integrity": "sha512-F3AMWcR44qMBt4kq+6Kb6mX7bjGXshktKFOPULd7reED6ZJWevjbNRqysP7q+AATE9kdPEZBibex1BYsvpVoeA==",
      "license": "Apache-2.0",
      "dependencies": {
        "playwright-core": "1.65.0"
      },
      "bin": {
        "playwright": "cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/playwright-core": {
      "version": "1.65.0",
      "resolved": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.65.0.tgz",
      "integrity": "sha512-vNSKgH6YqtN7cdT/L334zo0a+YwkrpicyrHJlWWPIm/Q+Nn2SWInil01oT0mbu96U4GgoRtCYQD9CzJQgju+lA==",
      "license": "Apache-2.0",
      "bin": {
        "playwright-core": "cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/siteshift": {
      "resolved": "apps/cli",
      "link": true
    },
    "packages/core": {
      "name": "@siteshift/core",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "playwright": "^1.65.0"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
